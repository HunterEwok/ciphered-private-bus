model streams
const max_streams=2
= node C halted=0 revoked=0 streams=
= node T halted=0 revoked=0 streams=
= pending 
= done 
commanderCall 1 ordered 2
= node C halted=0 revoked=0 streams=
= node T halted=0 revoked=0 streams=
= pending 1:ordered:2
= done 
commanderCall 2 lossy 0
= node C halted=0 revoked=0 streams=
= node T halted=0 revoked=0 streams=
= pending 1:ordered:2,2:lossy:0
= done 
learnRevoked C
= node C halted=0 revoked=1 streams=
= node T halted=0 revoked=0 streams=
= pending 1:ordered:2,2:lossy:0
= done 
resetNonces T
= node C halted=0 revoked=1 streams=
= node T halted=0 revoked=0 streams=
= pending 1:ordered:2,2:lossy:0
= done 
halt C
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=
= pending 1:ordered:2,2:lossy:0
= done 
targetOpen 2 lossy 0 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=1,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=0,recvd=0
= pending 1:ordered:2,2:lossy:0
= done 2
commanderReply 2 1 0 1
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=1,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=0,recvd=0
= pending 1:ordered:2
= done 2
sendChunk T 1 data 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=2,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=1,recvd=0
= pending 1:ordered:2
= done 2
sendChunk T 1 data 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=3,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=2,recvd=0
= pending 1:ordered:2
= done 2
targetOpen 1 ordered 2 1
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=3,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=2,recvd=0;2:k=1,mode=ordered,next=1,high=0,sc=2,rc=1,idle=0,got=2,granted=1,sent=0,recvd=0
= pending 1:ordered:2
= done 1,2
sendChunk T 1 data 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=4,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=3,recvd=0;2:k=1,mode=ordered,next=1,high=0,sc=2,rc=1,idle=0,got=2,granted=1,sent=0,recvd=0
= pending 1:ordered:2
= done 1,2
sendChunk T 2 data 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=4,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=3,recvd=0;2:k=1,mode=ordered,next=2,high=0,sc=1,rc=1,idle=0,got=2,granted=1,sent=1,recvd=0
= pending 1:ordered:2
= done 1,2
sendChunk T 2 credit 1
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=4,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=3,recvd=0;2:k=1,mode=ordered,next=3,high=0,sc=1,rc=2,idle=0,got=2,granted=2,sent=1,recvd=0
= pending 1:ordered:2
= done 1,2
sendChunk T 2 end 0
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=4,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=3,recvd=0
= pending 1:ordered:2
= done 1,2
commanderReply 1 2 1 1
= node C halted=1 revoked=1 streams=
= node T halted=0 revoked=0 streams=1:k=2,mode=lossy,next=4,high=0,sc=0,rc=0,idle=0,got=0,granted=0,sent=3,recvd=0
= pending 
= done 1,2
