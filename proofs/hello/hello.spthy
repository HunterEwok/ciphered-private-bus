/*
 * SPDX-License-Identifier: MPL-2.0
 * Copyright (C) 2026 HunterEwok
 *
 * The link hello (R-REL-1, R-FMT-15; Appendix B, Section B.4; property S14).
 * Both sides of a link send a Hello with their supported versions, a fresh
 * nonce, the bus, the root generation, the checkpoint number and their
 * device identifier, present their passport, and then send Auth: a device
 * key signature over
 *   cpb hello v1 || 0x00 || SHA-256(own hello) || SHA-256(peer's hello).
 * Verification level V1: a symbolic model, primitives are perfect.
 *
 * Abstractions, each stated here so that a reader can check them:
 * - A passport is the Root's signature over the bus, the device identifier
 *   and the device key, made for one bus. A relay presents its ticket
 *   instead, which the Root signs in the same way and which names the relay
 *   key; a relay keeps one key for every bus it serves, so tickets of many
 *   buses name the same key. Revocation, generations and checkpoint
 *   contents are left to the state model in models/membership; the
 *   generation and the checkpoint number are opaque fields of the hello
 *   here, and the lemmas show that both sides agree on them.
 * - The version list is an opaque term. The selected version is a function
 *   of both lists, so agreement on both lists is agreement on the version.
 * - Both sides run the same rules: either may speak first, and a side may
 *   run any number of hellos at once.
 * - Receivers match every field untyped: the adversary may send any term.
 * - Compromise: RevealDev gives a device signing key, RevealRelay a relay
 *   key (for every bus it serves), RevealRoot the root key of a bus. A key counts against a property only if it was revealed
 *   before the event.
 *
 * Probes (R-VER-2), each a deliberate defect selected with -D, each expected
 * to falsify the lemma named:
 *   PROBE_NO_PEER_HELLO  Auth signs the own hello only, not the peer's
 *                        (so not the peer's nonce)            -> peer_authentic
 *   PROBE_NO_VERSIONS    the hello hash leaves out the version
 *                        list                                 -> no_downgrade
 *   PROBE_SELF_HELLO     a hello naming the receiver's own device or
 *                        repeating its nonce is not rejected  -> no_self_connection
 *   PROBE_NO_BUS         the hello hash leaves out the bus    -> peer_authentic
 *   PROBE_NO_STATE       the hello hash leaves out the root
 *                        generation and the checkpoint number -> peer_authentic
 */

theory CpbHello
begin

builtins: hashing, signing

// The part of a hello that its hash covers.
#ifdef PROBE_NO_VERSIONS
macros: hhash(vs, n, bus, gen, cp, d) = h(<'cpb hello', n, bus, gen, cp, d>)
#endif
#ifdef PROBE_NO_BUS
macros: hhash(vs, n, bus, gen, cp, d) = h(<'cpb hello', vs, n, gen, cp, d>)
#endif
#ifdef PROBE_NO_STATE
macros: hhash(vs, n, bus, gen, cp, d) = h(<'cpb hello', vs, n, bus, d>)
#endif
#ifdef not PROBE_NO_VERSIONS & not PROBE_NO_BUS & not PROBE_NO_STATE
macros: hhash(vs, n, bus, gen, cp, d) = h(<'cpb hello', vs, n, bus, gen, cp, d>)
#endif

// What Auth signs: the hashes of the own hello and of the peer's hello.
#ifdef PROBE_NO_PEER_HELLO
macros: authmsg(own, peer) = <'cpb hello v1', own>
#else
macros: authmsg(own, peer) = <'cpb hello v1', own, peer>
#endif

restriction OneBus:
  "All b #i #j. NewBus(b) @ i & NewBus(b) @ j ==> #i = #j"

// The probe drops the check of B.4 by dropping the restriction it relies on.
#ifdef not PROBE_SELF_HELLO
restriction Inequality:
  "All x #i. Neq(x, x) @ i ==> F"
#endif

restriction OneDevice:
  "All b d #i #j. NewDevice(b, d) @ i & NewDevice(b, d) @ j ==> #i = #j"

/* ------------------------------------------------------------ bus and keys */

rule NewBus:
    [ Fr(~rk) ]
  --[ NewBus($B) ]->
    [ !RootLtk($B, ~rk), !Root($B, pk(~rk)), Out(pk(~rk)) ]

// The Root issues a passport: its signature over the bus, the device and the
// device key.
rule NewDevice:
    [ !RootLtk(B, rk), Fr(~ltk) ]
  --[ NewDevice(B, $D) ]->
    [ !Ltk(B, $D, ~ltk), !DevLtk(B, $D, ~ltk),
      Out(<pk(~ltk), sign(<'cpb passport v1', B, $D, pk(~ltk)>, rk)>) ]

// A relay has one key for every bus it serves.
rule NewRelay:
    [ Fr(~ltk) ]
  --[ NewRelay($R) ]->
    [ !RelayLtk($R, ~ltk), Out(pk(~ltk)) ]

// The Root of a bus issues a ticket that names the relay key.
rule Ticket:
    [ !RootLtk(B, rk), !RelayLtk(R, ltk) ]
  --[ NewDevice(B, R) ]->
    [ !Ltk(B, R, ltk),
      Out(<pk(ltk), sign(<'cpb passport v1', B, R, pk(ltk)>, rk)>) ]

rule RevealDev:
    [ !DevLtk(B, D, ltk) ]
  --[ RevealDev(B, D) ]->
    [ Out(ltk) ]

rule RevealRelay:
    [ !RelayLtk(R, ltk) ]
  --[ RevealRelay(R) ]->
    [ Out(ltk) ]

rule RevealRoot:
    [ !RootLtk(B, rk) ]
  --[ RevealRoot(B) ]->
    [ Out(rk) ]

/* ------------------------------------------------------------------- hello */

// A side sends its hello with its supported versions $V.
rule SendHello:
    [ !Ltk(B, X, ltk), Fr(~n) ]
  --[ HelloSent(B, X, $V, ~n) ]->
    [ HelloState(B, X, ltk, $V, ~n, $G, $C),
      Out(<'hello', $V, ~n, B, $G, $C, X>) ]

// It receives the peer's hello and passport, rejects a hello that names its
// own device or repeats its own nonce (B.4), checks the passport against the
// root key of its bus, and signs both hellos.
rule ReceiveHello:
    let own  = hhash(V, n, B, G, C, X)
        peer = hhash(vy, ny, B, gy, cy, Y)
    in
    [ HelloState(B, X, ltk, V, n, G, C), !Root(B, pk(rk)),
      In(<'hello', vy, ny, B, gy, cy, Y>),
      In(<pky, sign(<'cpb passport v1', B, Y, pky>, rk)>) ]
  --[ Signed(B, X, V, n, G, C, Y, vy, ny, gy, cy), Neq(Y, X), Neq(ny, n) ]->
    [ AuthState(B, X, V, n, G, C, Y, vy, ny, gy, cy, pky, own, peer),
      Out(sign(authmsg(own, peer), ltk)) ]

// It accepts the peer's Auth: the peer's device key over the peer's hello
// first and its own hello second.
rule ReceiveAuth:
    [ AuthState(B, X, V, n, G, C, Y, vy, ny, gy, cy, pk(ly), own, peer),
      In(sign(authmsg(peer, own), ly)) ]
  --[ Accepted(B, X, V, n, G, C, Y, vy, ny, gy, cy) ]->
    [ ]

/* ------------------------------------------------------------------ lemmas */

lemma executable:
  exists-trace
  "Ex B X Y vx nx gx cx vy ny gy cy #i #j.
     Accepted(B, X, vx, nx, gx, cx, Y, vy, ny, gy, cy) @ i
     & Accepted(B, Y, vy, ny, gy, cy, X, vx, nx, gx, cx) @ j
     & not X = Y
     & (not Ex b d #k. RevealDev(b, d) @ k)
     & (not Ex r #k. RevealRelay(r) @ k)
     & (not Ex b #k. RevealRoot(b) @ k)"

// A relay with tickets of two buses links on both with its one key.
lemma executable_relay:
  exists-trace
  "Ex B1 B2 R X1 X2 v1 n1 g1 c1 w1 m1 h1 d1 v2 n2 g2 c2 w2 m2 h2 d2 #i #j.
     Accepted(B1, X1, v1, n1, g1, c1, R, w1, m1, h1, d1) @ i
     & Accepted(B2, X2, v2, n2, g2, c2, R, w2, m2, h2, d2) @ j
     & (Ex #k. NewRelay(R) @ k)
     & not B1 = B2
     & (not Ex b d #k. RevealDev(b, d) @ k)
     & (not Ex r #k. RevealRelay(r) @ k)
     & (not Ex b #k. RevealRoot(b) @ k)"

// S14, R-REL-1: a side accepts a peer only if that peer signed exactly these
// two hellos on this bus, after it received this side's hello: the peer took
// part in this link, with this side's fresh nonce, and both agree on the
// versions, the root generations and the checkpoint numbers. The order of
// the hashes stops an Auth reflected between two devices; the bus in the
// hashes stops a relay's Auth from one bus being used on another.
lemma peer_authentic:
  "All B X vx nx gx cx Y vy ny gy cy #i.
     Accepted(B, X, vx, nx, gx, cx, Y, vy, ny, gy, cy) @ i
     ==> (Ex #j. Signed(B, Y, vy, ny, gy, cy, X, vx, nx, gx, cx) @ j & j < i)
       | (Ex #r. RevealDev(B, Y) @ r & r < i)
       | (Ex #r. RevealRelay(Y) @ r & r < i)
       | (Ex #r. RevealRoot(B) @ r & r < i)"

// R-FMT-15: the network and relays cannot force a downgrade. A side that
// accepts a peer saw the version list the peer sent, and the peer saw the
// list this side sent; so both select the same version.
lemma no_downgrade:
  "All B X vx nx gx cx Y vy ny gy cy #i.
     Accepted(B, X, vx, nx, gx, cx, Y, vy, ny, gy, cy) @ i
     ==> ((Ex #j. HelloSent(B, Y, vy, ny) @ j)
          & (Ex #k vz gz cz. Signed(B, Y, vz, ny, gz, cz, X, vx, nx, gx, cx) @ k))
       | (Ex #r. RevealDev(B, Y) @ r & r < i)
       | (Ex #r. RevealRelay(Y) @ r & r < i)
       | (Ex #r. RevealRoot(B) @ r & r < i)"

// B.4: a side never accepts a link with itself, even when the adversary
// reflects its own hello and Auth back to it.
lemma no_self_connection:
  "All B X vx nx gx cx vy ny gy cy #i. Accepted(B, X, vx, nx, gx, cx, X, vy, ny, gy, cy) @ i ==> F"

// One acceptance per hello: the fresh nonce of a side makes every accepted
// link a different one, so a recorded hello and Auth cannot be replayed.
lemma one_accept_per_hello:
  "All B X vx nx gx cx Y vy ny gy cy Z vz nz gz cz #i #j.
     Accepted(B, X, vx, nx, gx, cx, Y, vy, ny, gy, cy) @ i
     & Accepted(B, X, vx, nx, gx, cx, Z, vz, nz, gz, cz) @ j
     ==> #i = #j"

end
