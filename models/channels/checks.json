{
  "tlcInstance": "tiny",
  "witnessInstance": "tiny",
  "probes": [
    "no_rotate_on_remove",
    "mark_not_persisted",
    "grant_removed",
    "grant_no_read",
    "no_block_skip",
    "gen_not_persisted",
    "accept_old_grant",
    "accept_without_key",
    "empty_no_clear",
    "refill_moves_high",
    "high_not_persisted",
    "no_trim",
    "late_clear_kept",
    "grant_marked"
  ],
  "witnesses": [
    "witnessAccept",
    "witnessRefill",
    "witnessLateClear",
    "witnessClear",
    "witnessShrink",
    "witnessRotateAfterRemove",
    "witnessRefillAfterReboot"
  ],
  "inductive": {
    "instance": "small_ind",
    "smallInstance": "tiny_ind",
    "steps": [
      "stepEnvRemove",
      "stepEnvJoin",
      "stepSourceRotate",
      "stepSourceGrant",
      "stepSourcePublish",
      "stepSourceEpoch",
      "stepSourceReboot",
      "stepReaderGrant",
      "stepReaderPub",
      "stepReaderReboot"
    ]
  },
  "view": {
    "file": "view.qnt",
    "instance": "tiny_view",
    "operator": "safetyView"
  },
  "bisim": {
    "file": "view.qnt",
    "instance": "tiny_bisim",
    "smallInstance": "tiny_bisim",
    "parallel": 1,
    "jobs": [
      {
        "name": "init implies Struct",
        "init": "initStruct",
        "step": "stepSourceEpoch",
        "invariant": "structA",
        "steps": 0
      },
      {
        "name": "Struct and safety and EnvRemove imply Struct",
        "init": "initSafe",
        "step": "stepEnvRemove",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "EnvJoin has no transition from Struct and safety",
        "init": "initSafe",
        "step": "stepEnvJoin",
        "invariant": "structA",
        "steps": 1,
        "expect": "disabled"
      },
      {
        "name": "Struct and safety and SourceRotate imply Struct",
        "init": "initSafe",
        "step": "stepSourceRotate",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and SourceGrant imply Struct",
        "init": "initSafe",
        "step": "stepSourceGrant",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and SourcePublish imply Struct",
        "init": "initSafe",
        "step": "stepSourcePublish",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and SourceEpoch imply Struct",
        "init": "initSafe",
        "step": "stepSourceEpoch",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and SourceReboot imply Struct",
        "init": "initSafe",
        "step": "stepSourceReboot",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and ReaderGrant imply Struct",
        "init": "initSafe",
        "step": "stepReaderGrant",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and ReaderPub imply Struct",
        "init": "initSafe",
        "step": "stepReaderPub",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "Struct and safety and ReaderReboot imply Struct",
        "init": "initSafe",
        "step": "stepReaderReboot",
        "invariant": "structA",
        "steps": 1
      },
      {
        "name": "equal views agree on safety",
        "init": "initPair",
        "step": "stepSourceEpoch",
        "invariant": "sameSafety",
        "steps": 0
      },
      {
        "name": "EnvRemove answered with an equal view",
        "init": "initPair",
        "step": "matchEnvRemove",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "EnvJoin has no transition from a pair with equal views",
        "init": "initPair",
        "step": "matchEnvJoin",
        "invariant": "matched",
        "steps": 2,
        "expect": "disabled"
      },
      {
        "name": "SourceRotate answered with an equal view",
        "init": "initPair",
        "step": "matchSourceRotate",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "SourceGrant answered with an equal view",
        "init": "initPair",
        "step": "matchSourceGrant",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "SourcePublish answered with an equal view",
        "init": "initPair",
        "step": "matchSourcePublish",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "SourceEpoch answered with an equal view",
        "init": "initPair",
        "step": "matchSourceEpoch",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "SourceReboot answered with an equal view",
        "init": "initPair",
        "step": "matchSourceReboot",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "ReaderGrant answered with an equal view",
        "init": "initPair",
        "step": "matchReaderGrant",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "ReaderPub answered with an equal view",
        "init": "initPair",
        "step": "matchReaderPub",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "ReaderReboot answered with an equal view",
        "init": "initPair",
        "step": "matchReaderReboot",
        "invariant": "matched",
        "steps": 2
      },
      {
        "name": "witness: a pair with equal views",
        "init": "initPair",
        "step": "stepSourceEpoch",
        "invariant": "witnessPair",
        "steps": 0,
        "expect": "violated"
      },
      {
        "name": "witness: B answers a step",
        "init": "initPair",
        "step": "matchSourceEpoch",
        "invariant": "witnessAnswered",
        "steps": 2,
        "expect": "violated"
      }
    ],
    "result": "states with equal views are interchangeable for safety: TLC with the view is exact"
  }
}
